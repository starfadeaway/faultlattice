# FaultLattice 环境变量示例。
# 真实 .env 只在本地需要凭据时创建，且已被 .gitignore 排除，不要提交真实密钥。

# M3 反事实续跑的兼容默认端点；任务 YAML 登记默认模型 ID 与采样参数。
# 页面也可在启动前选择下方某个 chat 模型；选择和采样参数会冻结进该批次及 run.json。
# 密钥仅在本机读取，不写入套件状态、run.json、轨迹或报告。
FAULTLATTICE_MODEL_API_KEY=
FAULTLATTICE_MODEL_BASE_URL=

# 实验结果的 LLM 修改建议；为避免隐式计费，模型 ID 必须显式配置。
# 与 M3 共用上述兼容端点和密钥，建议不会自动修改代码或 Oracle。
FAULTLATTICE_ADVISOR_MODEL_ID=

# 可选：多模型目录。复制整组并替换 <ID> 为大写提供方名，例如 KIMI、OPENAI。
# 只有 CAPABILITIES 包含 chat 且密钥、模型 ID 完整的项目会出现在建议模型选择器中。
FAULTLATTICE_LLM_KIMI_API_KEY=
FAULTLATTICE_LLM_KIMI_BASE_URL=
FAULTLATTICE_LLM_KIMI_MODEL_ID=
FAULTLATTICE_LLM_KIMI_LABEL=Kimi
FAULTLATTICE_LLM_KIMI_CAPABILITIES=chat
# 每个模型可显式声明 JSON object 采样覆盖；启动前冻结，不在请求失败后暗中修改。
# 当前 kimi-k3.1-pro 端点只接受 temperature=1。
FAULTLATTICE_LLM_KIMI_SAMPLING_PARAMS={"temperature":1}
# 可选：建议专用覆盖在通用参数之后合并，但绝不会进入 M3 冻结任务。
# 例如 MiniMax 建议可显式设置 {"reasoning_effort":"low"}，保留思考并避免默认 max 深度。
# FAULTLATTICE_LLM_MINIMAX_ADVISOR_SAMPLING_PARAMS={"reasoning_effort":"low"}

# DeepSeek 思考模式：M3 现场建立真实前缀并完整回传 reasoning_content，不自动降级。
# 可选 default / enabled / disabled；disabled 是显式非思考实验条件，不是错误修复。
FAULTLATTICE_LLM_DEEPSEEK_API_KEY=
FAULTLATTICE_LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
FAULTLATTICE_LLM_DEEPSEEK_MODEL_ID=deepseek-flash
FAULTLATTICE_LLM_DEEPSEEK_LABEL=DeepSeek Flash
FAULTLATTICE_LLM_DEEPSEEK_CAPABILITIES=chat
FAULTLATTICE_LLM_DEEPSEEK_REASONING_MODE=enabled

# 仅向量化配置示例：embedding-only 不会用于修改建议或 M3 对话。
FAULTLATTICE_LLM_SILICONFLOW_API_KEY=
FAULTLATTICE_LLM_SILICONFLOW_BASE_URL=
FAULTLATTICE_LLM_SILICONFLOW_MODEL_ID=
FAULTLATTICE_LLM_SILICONFLOW_LABEL=硅基流动（仅向量化）
FAULTLATTICE_LLM_SILICONFLOW_CAPABILITIES=embedding
# 当前冻结为 BAAI/bge-m3、1024 维、L2 归一化；此值是索引配置版本，不是伪造的上游权重 SHA。
FAULTLATTICE_EMBEDDING_MODEL_VERSION=bge-m3

# 可选：MySQL 可重建结构索引。命令不会启动数据库；请预先创建空数据库并授权。
FAULTLATTICE_MYSQL_HOST=127.0.0.1
FAULTLATTICE_MYSQL_PORT=3306
FAULTLATTICE_MYSQL_USER=
FAULTLATTICE_MYSQL_PASSWORD=
FAULTLATTICE_MYSQL_DATABASE=

# 研发控制台本地监听地址；仅绑定回环地址，不对外开放。
FAULTLATTICE_SERVER_PORT=8001
FAULTLATTICE_CLIENT_PORT=5173
